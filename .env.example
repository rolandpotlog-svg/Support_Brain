# ── Support-Brain — Umgebungsvariablen ────────────────────────────────────
# Kopiere nach .env und fülle die Werte. .env ist gitignored.

# Lokale, selbst gehostete Postgres (Homebrew). Kein Passwort bei lokalem Trust-Auth.
# Auf dem VPS später z. B.: postgresql://user:pass@localhost:5432/support_brain
DATABASE_URL=postgresql://DEINUSER@localhost:5432/support_brain

# Auth.js / NextAuth Session-Secret. Erzeugen: openssl rand -base64 32
AUTH_SECRET=

# Verschlüsselung der Postfach-Passwörter (32 Byte, base64).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_ENC_KEY=

# Worker
POLL_INTERVAL_SECONDS=60
MAX_SEND_ATTEMPTS=5

# Basis-URL der App — für die Shopify-OAuth-Callback-URL.
# Lokal: http://localhost:3000  ·  VPS: https://deine-domain
# Im Dev Dashboard der App diese + "/api/shopify/callback" als Redirect-URL eintragen.
APP_URL=http://localhost:3000

# Shopify: Zugang wird PRO SHOP im Admin gesetzt (Domain + Client-ID/Secret der
# Dev-Dashboard-App, dann "Mit Shopify verbinden" = OAuth). Verschlüsselt in der DB.
# Keine globalen Shopify-Variablen mehr nötig.

# Backups (optional; Standard: ./backups, 14 Stück aufbewahren)
# BACKUP_DIR=
# BACKUP_KEEP=14
