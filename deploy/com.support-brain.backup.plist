<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd: täglich um 03:00 ein DB-Backup. Installation siehe README.
     Auf einem Linux-VPS stattdessen Cron nutzen:  0 3 * * * /pfad/scripts/backup.sh -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.support-brain.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rolandpotlog/Projekte/30_ECom_Alpennord/Support-Brain/scripts/backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/rolandpotlog/Projekte/30_ECom_Alpennord/Support-Brain/backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rolandpotlog/Projekte/30_ECom_Alpennord/Support-Brain/backups/backup.log</string>
</dict>
</plist>
